# Clerk publishable key — required. Without it the app cannot start.
# https://dashboard.clerk.com/last-active?path=api-keys
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the backend API.
VITE_API_BASE_URL=

# Mapbox access token used by address lookup.
VITE_MAPBOX_TOKEN=

# PayFast merchant ID. Falls back to the PayFast sandbox ID when unset.
VITE_PAYFAST_MERCHANT_ID=
